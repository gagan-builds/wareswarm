# Purpose: Environment variable configuration template for WareSwarm.
# Role in the project: Defines configuration defaults for both FastAPI backend and Next.js frontend services.
# Key contents: DATABASE_URL, CORS_ORIGINS, NEXT_PUBLIC_API_URL, NEXT_PUBLIC_WS_URL.
# Talks to: backend/app/config.py, frontend/lib/api.ts, frontend/lib/useSimWebSocket.ts.

# ---- Backend Settings ----
# Database connection URL (default: local SQLite database file)
DATABASE_URL=sqlite:///./wareswarm.db
# Uncomment below to connect to a production PostgreSQL instance instead:
# DATABASE_URL=postgresql://user:password@localhost:5432/wareswarm

# CORS allowed origins (comma-separated origins permitted to make cross-origin requests)
CORS_ORIGINS=http://localhost:3000

# ---- Frontend Settings ----
# Base URL for the FastAPI REST backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL for the FastAPI WebSocket live simulation stream
NEXT_PUBLIC_WS_URL=ws://localhost:8000
